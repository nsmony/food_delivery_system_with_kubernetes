# Copy this file to 03-secret.yaml, fill in the real values, then apply. 03-secret.yaml is git-ignored.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: fooddelivery
type: Opaque
stringData:
  # MongoDB Atlas (cloud database)
  MONGO_URI: "mongodb+srv://<db_username>:<db_password>@cluster0.1s6tq4a.mongodb.net/fooddelivery?retryWrites=true&w=majority"
  # any long random string; used by the gateway and the login service
  JWT_SECRETE: "<paste-a-long-random-string>"
